  COMMAND = C:\Windows\system32\cmd.exe /C "cd /D C:\a1e\Tests\c1e\C2e\build\ror\doc && "C:\Program Files\CMake\bin\cmake.exe" -DCMAKE_INSTALL_DO_STRIP=1 -P cmake_install.cmake"
  DESC = Installing the project stripped...
  pool = console
  restat = 1

build doc/install/strip: phony doc/CMakeFiles/install/strip.util

